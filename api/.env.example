NODE_ENV=development
API_PORT=7381
# Se admiten varios orígenes separados por coma.
CORS_ORIGIN=http://localhost:5287
DATABASE_URL=postgresql://ecommercevm:ecommercevm_dev@localhost:5547/ecommercevm?schema=public
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
# Clave independiente para cifrar credenciales de OCA y otros proveedores (mínimo 32 caracteres).
# En producción es obligatoria y debe persistir entre despliegues. No reutilizar JWT_SECRET.
SHIPPING_ENCRYPTION_KEY=CAMBIAR_POR_OTRO_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
ADMIN_EMAIL=admin@ecommercevm.local
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA_DE_12_CARACTERES
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PEGAR_SERVICE_ROLE_KEY_SOLO_EN_API_ENV
SUPABASE_BUCKET=product-images

# ARCA WSAA (no activar hasta contar con certificado de homologación asociado a WSFE)
# ARCA_CUIT=20123456789
# ARCA_CERTIFICATE_PATH=/ruta/segura/certificado.pem
# ARCA_PRIVATE_KEY_PATH=/ruta/segura/clave-privada.pem
# ARCA_OPENSSL_PATH=openssl
# Datos legales del emisor requeridos para generar el PDF fiscal autorizado
# ARCA_ISSUER_NAME=Nombre o razón social del emisor
# ARCA_ISSUER_ADDRESS=Domicilio fiscal del emisor
# ARCA_ISSUER_VAT_CONDITION=Monotributista

# GOcuotas API Redirect V1 (usar credenciales de integración de la sucursal y base URL del ambiente)
# GOCUOTAS_API_BASE_URL=https://www.gocuotas.com/api_redirect/v1/
# GOCUOTAS_EMAIL=
# GOCUOTAS_PASSWORD=

# Mercado Pago Checkout Pro (Orders API)
# Requiere Access Token privado y secreto de firma de Webhooks de la misma aplicación.
# Configurá URLs HTTPS públicas cuando la API y el frontend estén desplegados.
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# PUBLIC_APP_URL=https://tu-tienda.example
# PUBLIC_API_URL=https://tu-api.example
