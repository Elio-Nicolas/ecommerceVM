generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}
enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}
enum FiscalDocumentType {
  INVOICE_C
  CREDIT_NOTE_C
  DEBIT_NOTE_C
}
enum FiscalDocumentStatus {
  PENDING
  ISSUING
  AUTHORIZED
  REJECTED
  UNKNOWN
}
enum ArcaEnvironment {
  HOMOLOGATION
  PRODUCTION
}
enum PaymentAttemptStatus {
  CREATING
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  UNKNOWN
  REFUNDED
  PARTIALLY_REFUNDED
}
model AdminUser {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  isActive Boolean @default(true)
  orderStatusChanges OrderStatusHistory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Category {
  id String @id @default(uuid())
  name String
  slug String @unique
  description String?
  products Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([name])
}
model Product {
  id String @id @default(uuid())
  sku String @unique
  slug String @unique
  name String
  description String
  priceArs Int
  compareAtArs Int?
  stock Int @default(0)
  weightGrams Int?
  packageLengthCm Int?
  packageWidthCm Int?
  packageHeightCm Int?
  status ProductStatus @default(DRAFT)
  featured Boolean @default(false)
  badge String?
  imageUrl String?
  specs String[] @default([])
  categoryId String
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, categoryId])
  @@index([featured, createdAt])
  @@index([name])
}
model ShippingOrigin {
  id String @id @default(uuid())
  name String
  provinceCode String
  postalCode String
  isDefault Boolean @default(false)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isActive, isDefault])
}
model ShippingSettings {
  id String @id @default("default")
  ocaEnvironment String @default("QA")
  ocaUsernameEncrypted String?
  ocaPasswordEncrypted String?
  ocaCuitEncrypted String?
  ocaOperativeEncrypted String?
  pickupEnabled Boolean @default(true)
  pickupAddress String @default("Domicilio del vendedor")
  pickupInstructions String @default("La dirección exacta y el horario se coordinarán luego de confirmar el pedido.")
  localDeliveryEnabled Boolean @default(false)
  localDeliveryPostalCodes String[] @default([])
  localDeliveryFeeArs Int @default(0)
  localDeliveryInternalCostArs Int?
  localDeliveryCoordinate Boolean @default(false)
  updatedAt DateTime @updatedAt
}
model ArcaSettings {
  id String @id @default("default")
  enabled Boolean @default(false)
  environment ArcaEnvironment @default(HOMOLOGATION)
  pointOfSale Int?
  updatedAt DateTime @updatedAt
}
model Order {
  id String @id @default(uuid())
  code String @unique
  checkoutRequestKey String? @unique
  checkoutFingerprint String?
  status OrderStatus @default(PENDING)
  customerName String
  customerEmail String?
  customerPhone String
  addressLine String
  city String
  province String
  postalCode String?
  customerNotes String?
  subtotalArs Int
  shippingCostArs Int?
  totalArs Int?
  shippingCarrier String?
  trackingCode String?
  shippingService String?
  shippingEstimatedHours Int?
  shippingQuoteId String?
  shippingOptionKey String?
  shippingCostOptions Json?
  deliveryMethod String @default("OCA")
  shippingInternalCostArs Int?
  deliveryInstructions String?
  provinceCode String?
  items OrderItem[]
  history OrderStatusHistory[]
  fiscalDocuments FiscalDocument[]
  paymentAttempts PaymentAttempt[]
  shipments ShippingShipment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([customerPhone])
  @@index([customerName])
}
model ShippingShipment {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider String
  status String @default("CREATED")
  externalAdmissionId String?
  trackingNumber String?
  serviceCode String?
  serviceLabel String?
  parcels Json
  labelPdf Bytes?
  labelMimeType String?
  admittedAt DateTime?
  processedAt DateTime?
  lastError String?
  events ShippingShipmentEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([orderId, provider])
  @@index([provider, status, updatedAt])
  @@index([trackingNumber])
}

model ShippingShipmentEvent {
  id String @id @default(uuid())
  shipmentId String
  shipment ShippingShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  externalEventId String?
  eventType String
  status String @default("RECEIVED")
  payload Json?
  receivedAt DateTime @default(now())
  lockedAt DateTime?
  processedAt DateTime?
  attempts Int @default(0)
  lastError String?
  @@unique([shipmentId, externalEventId])
  @@index([status, receivedAt])
  @@index([status, lockedAt])
  @@index([shipmentId, receivedAt])
}

model PaymentAttempt {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider String @default("MERCADO_PAGO")
  requestKey String @unique
  providerOrderId String? @unique
  checkoutUrl String?
  amountArs Int
  currencyCode String @default("ARS")
  status PaymentAttemptStatus @default(CREATING)
  statusDetail String?
  approvedAt DateTime?
  responsePayload Json?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([orderId, createdAt])
  @@index([status, createdAt])
}
model FiscalDocument {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  type FiscalDocumentType
  status FiscalDocumentStatus @default(PENDING)
  requestKey String @unique
  pointOfSale Int?
  voucherType Int
  voucherNumber Int?
  issueDate DateTime?
  receiverDocumentType Int?
  receiverDocumentNumber String?
  receiverVatConditionId Int?
  receiverName String?
  receiverAddress String?
  currencyCode String @default("PES")
  currencyRate Decimal? @db.Decimal(18, 6)
  concept Int @default(1)
  netAmountArs Int @default(0)
  exemptAmountArs Int @default(0)
  nonTaxedAmountArs Int @default(0)
  vatAmountArs Int @default(0)
  tributeAmountArs Int @default(0)
  totalAmountArs Int
  cae String?
  caeExpiresAt DateTime?
  authorizedAt DateTime?
  relatedDocumentId String?
  relatedDocument FiscalDocument? @relation("FiscalDocumentRelated", fields: [relatedDocumentId], references: [id], onDelete: SetNull)
  relatedDocuments FiscalDocument[] @relation("FiscalDocumentRelated")
  items Json
  requestPayload Json?
  responsePayload Json?
  pdf Bytes?
  lastErrorCode String?
  lastErrorMessage String?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@index([cae])
}
model ShippingQuote {
  id String @id @default(uuid())
  provinceCode String
  postalCode String
  cartFingerprint String
  subtotalArs Int
  options Json
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([expiresAt, usedAt])
}
model OrderItem {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  productSku String
  unitPriceArs Int
  quantity Int
  lineTotalArs Int
  weightGrams Int?
  packageLengthCm Int?
  packageWidthCm Int?
  packageHeightCm Int?
  createdAt DateTime @default(now())
  @@index([orderId])
  @@index([productId])
}
model OrderStatusHistory {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus OrderStatus
  note String?
  changedByAdminId String?
  changedByAdmin AdminUser? @relation(fields: [changedByAdminId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([orderId, createdAt])
}