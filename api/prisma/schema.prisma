generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}
enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}
model AdminUser {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  isActive Boolean @default(true)
  orderStatusChanges OrderStatusHistory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Category {
  id String @id @default(uuid())
  name String
  slug String @unique
  description String?
  products Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([name])
}
model Product {
  id String @id @default(uuid())
  sku String @unique
  slug String @unique
  name String
  description String
  priceArs Int
  compareAtArs Int?
  stock Int @default(0)
  weightGrams Int?
  packageLengthCm Int?
  packageWidthCm Int?
  packageHeightCm Int?
  status ProductStatus @default(DRAFT)
  featured Boolean @default(false)
  badge String?
  imageUrl String?
  specs String[] @default([])
  categoryId String
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, categoryId])
  @@index([featured, createdAt])
  @@index([name])
}
model ShippingOrigin {
  id String @id @default(uuid())
  name String
  provinceCode String
  postalCode String
  enviopackAddressId String?
  isDefault Boolean @default(false)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isActive, isDefault])
}
model Order {
  id String @id @default(uuid())
  code String @unique
  status OrderStatus @default(PENDING)
  customerName String
  customerEmail String?
  customerPhone String
  addressLine String
  city String
  province String
  postalCode String?
  customerNotes String?
  subtotalArs Int
  shippingCostArs Int?
  totalArs Int?
  shippingCarrier String?
  trackingCode String?
  shippingService String?
  shippingEstimatedHours Int?
  shippingQuoteId String?
  shippingOptionKey String?
  shippingCostOptions Json?
  items OrderItem[]
  history OrderStatusHistory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([customerPhone])
  @@index([customerName])
}
model ShippingQuote {
  id String @id @default(uuid())
  provinceCode String
  postalCode String
  cartFingerprint String
  subtotalArs Int
  options Json
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([expiresAt, usedAt])
}
model OrderItem {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  productSku String
  unitPriceArs Int
  quantity Int
  lineTotalArs Int
  createdAt DateTime @default(now())
  @@index([orderId])
  @@index([productId])
}
model OrderStatusHistory {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus OrderStatus
  note String?
  changedByAdminId String?
  changedByAdmin AdminUser? @relation(fields: [changedByAdminId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([orderId, createdAt])
}
